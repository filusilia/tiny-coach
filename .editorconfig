root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.{vue,ts,tsx,js,jsx,cjs,mjs,json,css,scss,html}]
indent_style = space
indent_size = 2

[*.{md,yaml,yml,ps1,cfg}]
indent_style = space
indent_size = 2

