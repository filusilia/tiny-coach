<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <LinearGradientBrush x:Key="GamePageBackgroundBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF121212" Offset="0" /><GradientStop Color="#FF1E1E1E" Offset="1" /></LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroBannerOverlayBrush" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#F20B0D10" Offset="0" /><GradientStop Color="#B3111418" Offset="0.48" /><GradientStop Color="#38111418" Offset="0.76" /><GradientStop Color="#14111418" Offset="1" /></LinearGradientBrush>
      <SolidColorBrush x:Key="GameSurfaceBrush" Color="#EE1C1E22" />
      <SolidColorBrush x:Key="GameSurfaceRaisedBrush" Color="#FF282B30" />
      <SolidColorBrush x:Key="GameSurfaceSubtleBrush" Color="#E61A1C20" />
      <SolidColorBrush x:Key="GameBorderBrush" Color="#32FFFFFF" />
      <SolidColorBrush x:Key="GameTextPrimaryBrush" Color="#FFF4F4F4" />
      <SolidColorBrush x:Key="GameTextSecondaryBrush" Color="#FFC4C7CD" />
      <SolidColorBrush x:Key="GameTextMutedBrush" Color="#FF9398A1" />
      <SolidColorBrush x:Key="GameAccentBrush" Color="{ThemeResource SystemAccentColorLight1}" />
      <SolidColorBrush x:Key="ScepterGlowBrush" Color="#FF5AB8FF" />
      <SolidColorBrush x:Key="ShardGlowBrush" Color="#FFD141FF" />
      <SolidColorBrush x:Key="TalentLevelBadgeBrush" Color="#FF1E293B" />
      <SolidColorBrush x:Key="TalentLevelTextBrush" Color="#FFF59E0B" />
      <SolidColorBrush x:Key="TalentNodeBackgroundBrush" Color="#FF24272C" />
      <SolidColorBrush x:Key="TalentNodeBorderBrush" Color="#33FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <LinearGradientBrush x:Key="GamePageBackgroundBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFF7F7F8" Offset="0" /><GradientStop Color="#FFECEEF1" Offset="1" /></LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroBannerOverlayBrush" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#E80B0D10" Offset="0" /><GradientStop Color="#A8111418" Offset="0.48" /><GradientStop Color="#32111418" Offset="0.76" /><GradientStop Color="#10111418" Offset="1" /></LinearGradientBrush>
      <SolidColorBrush x:Key="GameSurfaceBrush" Color="#F9FFFFFF" />
      <SolidColorBrush x:Key="GameSurfaceRaisedBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="GameSurfaceSubtleBrush" Color="#FFF1F2F4" />
      <SolidColorBrush x:Key="GameBorderBrush" Color="#29000000" />
      <SolidColorBrush x:Key="GameTextPrimaryBrush" Color="#FF17181A" />
      <SolidColorBrush x:Key="GameTextSecondaryBrush" Color="#FF484B51" />
      <SolidColorBrush x:Key="GameTextMutedBrush" Color="#FF6A6E76" />
      <SolidColorBrush x:Key="GameAccentBrush" Color="{ThemeResource SystemAccentColorDark1}" />
      <SolidColorBrush x:Key="ScepterGlowBrush" Color="#FF006EAE" />
      <SolidColorBrush x:Key="ShardGlowBrush" Color="#FF8A1CAC" />
      <SolidColorBrush x:Key="TalentLevelBadgeBrush" Color="#FEF3C7" />
      <SolidColorBrush x:Key="TalentLevelTextBrush" Color="#B45309" />
      <SolidColorBrush x:Key="TalentNodeBackgroundBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="TalentNodeBorderBrush" Color="#24000000" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="GamePageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="HeroBannerOverlayBrush" Color="#CC000000" />
      <SolidColorBrush x:Key="GameSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GameSurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GameSurfaceSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GameBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GameTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GameTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GameTextMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="GameAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ScepterGlowBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ShardGlowBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="TalentLevelBadgeBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="TalentLevelTextBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="TalentNodeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="TalentNodeBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Style x:Key="GamePanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource GameSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource GameBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style x:Key="GameSectionTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource GameTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="GameCaptionStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource GameTextMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="GameIconButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
</ResourceDictionary>
