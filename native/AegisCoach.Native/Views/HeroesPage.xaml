<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AegisCoach.Native.Views.HeroesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:models="using:AegisCoach.Native.Models"
    xmlns:viewmodels="using:AegisCoach.Native.ViewModels"
    Unloaded="Page_Unloaded">

  <Grid x:Name="RootGrid"
        Background="{ThemeResource GamePageBackgroundBrush}"
        Padding="16,10,16,12">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="ResponsiveStates">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1100" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Compact">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="RootGrid.Padding" Value="10,8,10,10" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- ================= 1. 列表视图（单行高密度控制栏 + 英雄卡片网格） ================= -->
    <Grid x:Name="HeroListHost" RowSpacing="6"
          Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
          SizeChanged="HeroListHost_SizeChanged">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Row 0：英雄分类与筛选控制栏（全部/力量/敏捷/智力/全才 完整展示，分段与胜率选择器字迹清晰） -->
      <!-- Row 0：英雄分类与筛选控制栏（全部/力量/敏捷/智力/全才 完整展示无裁切，分段与胜率选择器字迹清晰） -->
      <Grid Grid.Row="0" ColumnSpacing="12" MinHeight="42" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <!-- 左侧：属性分类 Tabs（全部/力量/敏捷/智力/全才） -->
          <ColumnDefinition Width="*" />
          <!-- 右侧：英雄计数 + 分段筛选 + 胜率排序 -->
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 紧凑属性分类 Tabs（全部/力量/敏捷/智力/全才 完整图标与中英文标注，42px 高度预留边框空间，彻底杜绝底部截断） -->
        <ListView Grid.Column="0" x:Name="AttributeTabs" Height="42"
                  ItemsSource="{Binding HeroSections}"
                  SelectionMode="Single"
                  SelectionChanged="AttributeTabs_SelectionChanged"
                  BorderThickness="0" Padding="0,2,0,2" Margin="0"
                  VerticalAlignment="Center"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.VerticalScrollMode="Disabled">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListView.ItemsPanel>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="MinHeight" Value="36" />
              <Setter Property="Height" Value="36" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,8,0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate>
              <Border Height="36" Padding="12,0"
                      Background="{ThemeResource GameSurfaceSubtleBrush}"
                      BorderBrush="{ThemeResource GameBorderBrush}"
                      BorderThickness="1" CornerRadius="6"
                      VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <Image Source="{Binding IconUrl}" Width="18" Height="18" Stretch="Uniform" />
                  <TextBlock Text="{Binding Title}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource GameTextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <!-- 右侧：英雄计数 + 冠绝等分段选择 + 胜率/出场率排序（刷新功能统一由顶部标题栏承担） -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding ResultCountText}" FontSize="12"
                     Foreground="{ThemeResource GameTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />

          <!-- 分段选择（冠绝一世 / 超凡先锋等完整展示，官方段位勋章 + 文字） -->
          <ComboBox MinWidth="130" Height="34"
                    ItemsSource="{Binding RankOptions}"
                    SelectedItem="{Binding SelectedRank, Mode=TwoWay}"
                    AutomationProperties.Name="选择分段" VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Image Source="{Binding IconUrl}" Width="18" Height="18" Stretch="Uniform" />
                  <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{ThemeResource GameTextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- 排序选择（按名字 / 按胜率 / 按登场率 完整展示） -->
          <ComboBox MinWidth="110" Height="34"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                    DisplayMemberPath="Label"
                    AutomationProperties.Name="选择排序方式" VerticalAlignment="Center" />

          <!-- 隐藏占位搜索框（代码后向兼容） -->
          <AutoSuggestBox x:Name="SearchBox" Visibility="Collapsed" />
        </StackPanel>
      </Grid>

      <!-- Row 1：英雄卡片网格 / 加载 / 错误 / 空结果 -->
      <Grid Grid.Row="1">
        <!-- 加载态 -->
        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
          <ProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
          <TextBlock Text="正在同步英雄资料…" FontSize="12"
                     Foreground="{ThemeResource GameTextSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 空结果态 -->
        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
          <FontIcon Glyph="&#xE721;" FontSize="28" Foreground="{ThemeResource GameTextMutedBrush}"
                    HorizontalAlignment="Center" />
          <TextBlock Text="没有匹配的英雄，试试调整搜索或筛选" FontSize="12"
                     Foreground="{ThemeResource GameTextMutedBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 错误提示 -->
        <InfoBar IsOpen="{Binding HasError}" Severity="Error" IsClosable="False"
                 HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="680"
                 Title="无法加载英雄数据" Message="{Binding ErrorMessage}">
          <InfoBar.ActionButton>
            <Button Content="重试" Command="{Binding LoadCommand}" />
          </InfoBar.ActionButton>
        </InfoBar>

        <!-- 网格列表 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <GridView x:Name="HeroGrid"
                    ItemsSource="{Binding VisibleAttributeHeroes}"
                    SelectionMode="Single"
                    IsItemClickEnabled="False"
                    SelectionChanged="HeroGrid_SelectionChanged"
                    HorizontalAlignment="Stretch" Padding="0">
            <GridView.ItemsPanel>
              <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
              <Style TargetType="GridViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
              <DataTemplate>
                <Border Width="{Binding CardWidth}" Height="{Binding ImageHeight}"
                        Background="{ThemeResource GameSurfaceBrush}"
                        BorderBrush="{ThemeResource GameBorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                  <Grid>
                    <Image Source="{Binding DisplayImage}" Stretch="UniformToFill" />
                    <!-- 顶部官方主属性图标 + 攻击类型（近战/远程）官方图标 -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                            Background="#CC000000" CornerRadius="4" Padding="3,2">
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Image Source="{Binding PrimaryAttributeIcon}" Width="15" Height="15" Stretch="Uniform"
                               ToolTipService.ToolTip="{Binding AttributeLabel}" />
                        <Image Source="{Binding AttackTypeIcon}" Width="15" Height="15" Stretch="Uniform"
                               ToolTipService.ToolTip="{Binding AttackLabel}" />
                      </StackPanel>
                    </Border>
                    <!-- 底部渐变名称与胜率条 -->
                    <Border VerticalAlignment="Bottom" Padding="6,4">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#00000000" Offset="0" />
                          <GradientStop Color="#E60A0C10" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <Grid>
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WinRateText}" Foreground="{ThemeResource CoachGoldLightBrush}" FontSize="10"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </GridView.ItemTemplate>
          </GridView>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ================= 2. 详情视图（左右分栏高利用率布局：左信息+出装对阵，右技能+天赋全景） ================= -->
    <Grid x:Name="HeroDetailRoot"
          Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 顶部紧凑面包屑返回栏 -->
      <Grid Grid.Row="0" Margin="0,0,0,8" MinHeight="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Height="30" Padding="8,2" CornerRadius="5"
                  Command="{Binding CloseDetailCommand}"
                  ToolTipService.ToolTip="返回英雄列表" AutomationProperties.Name="返回英雄列表">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <FontIcon Glyph="&#xE72B;" FontSize="12" />
              <TextBlock Text="返回列表" FontSize="11" />
            </StackPanel>
          </Button>
          <Border Width="1" Height="14" Background="{ThemeResource GameBorderBrush}" Margin="2,0" />
          <TextBlock Text="{Binding DetailHeroName}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding DetailEnglishName}" Foreground="{ThemeResource GameTextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
          <!-- 主属性胶囊 -->
          <Border Background="{Binding DetailAttrBadgeBrush}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Image Source="{Binding DetailPrimaryAttributeIcon}" Width="14" Height="14" Stretch="Uniform" />
              <TextBlock Text="{Binding DetailAttrBadgeText}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <!-- 近战/远程：使用主题自适应矢量图形与前景色，浅色/深色主题下对比度 100% 清晰可见 -->
          <Border Background="{ThemeResource GameSurfaceRaisedBrush}" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <!-- 近战图标（矢量剑） -->
              <Viewbox Width="12" Height="12" VerticalAlignment="Center" Visibility="{Binding IsDetailMelee, Converter={StaticResource BoolToVisibilityConverter}}">
                <Path Data="M16.9963 0.404933C17.0125 0.294435 16.975 0.183229 16.8964 0.103897C16.8177 0.0245649 16.7058 -0.0129761 16.5953 0.00402358C11.9839 0.668428 11.9641 0.674095 11.9308 0.684011C11.8004 0.722969 11.6843 0.798759 11.595 0.900757L5.25233 8.5145C5.18999 8.58958 5.07807 8.6002 5.00298 8.53716C4.99873 8.53362 4.99448 8.53008 4.99094 8.52654L3.47646 7.01215C3.06845 6.58999 2.39621 6.57866 1.97403 6.98594C1.55184 7.39322 1.54051 8.06613 1.94782 8.48829C1.95632 8.49679 1.96482 8.506 1.97403 8.5145L8.486 15.0254C8.88905 15.4518 9.562 15.4702 9.98843 15.0665C10.4149 14.6634 10.4333 13.9905 10.0295 13.5641C10.0161 13.5499 10.0019 13.5358 9.98772 13.5223L8.47325 12.0086C8.40383 11.9392 8.40383 11.8273 8.47325 11.7579C8.47679 11.7544 8.48104 11.7501 8.48529 11.7473L16.1087 5.39789C16.2185 5.2973 16.295 5.16485 16.3276 5.01893L16.9963 0.404933ZM14.189 2.81322C14.3959 3.02076 14.3959 3.35651 14.189 3.56404L7.35828 10.3937C7.22015 10.5318 6.9956 10.5318 6.85747 10.3937L6.60742 10.1436C6.46858 10.0055 6.46858 9.78097 6.60671 9.64285L13.4374 2.81252C13.645 2.60498 13.9815 2.60569 14.189 2.81322ZM0.414923 14.5813C-0.138308 15.1345 -0.138308 16.0319 0.414923 16.5851C0.968154 17.1383 1.86565 17.1383 2.41888 16.5851L5.12624 13.8779C5.26437 13.7398 5.26437 13.5152 5.12624 13.3771L3.6238 11.8748C3.48567 11.7366 3.26112 11.7366 3.12299 11.8748L0.414923 14.5813Z"
                      Fill="{ThemeResource GameTextPrimaryBrush}" />
              </Viewbox>
              <!-- 远程图标（矢量弓箭） -->
              <Viewbox Width="12" Height="12" VerticalAlignment="Center" Visibility="{Binding IsDetailRanged, Converter={StaticResource BoolToVisibilityConverter}}">
                <Path Data="M29 1.34981C28.9991 0.604204 28.3947 -6.20436e-05 27.65 4.7781e-09L23.271 0.000365069C22.5253 0.00138188 21.9208 0.60575 21.9208 1.35041C21.9208 1.70746 22.063 2.05209 22.316 2.30506L23.3118 3.30071C23.5753 3.56419 23.5753 3.99189 23.3118 4.2554L8.12177 19.4429C7.98999 19.5746 7.77611 19.5747 7.64435 19.4429C7.59279 19.3914 7.55938 19.3236 7.54888 19.252L5.83589 7.83312C5.79771 7.57536 5.91232 7.31758 6.13003 7.17245C9.41968 4.69667 13.8798 4.45476 17.4163 6.56242C17.6799 6.71515 18.015 6.67216 18.2308 6.45638L19.6766 5.01086C19.9402 4.74735 19.9411 4.3206 19.6786 4.05618C19.6394 4.01704 19.5955 3.98267 19.5478 3.95404C14.6268 0.805889 8.21399 1.30095 3.8338 5.16684C3.36971 5.57931 2.76243 5.58699 2.10746 4.93213C1.84395 4.66866 1.41618 4.6687 1.15262 4.93221L0.197693 5.88698C-0.0658664 6.1505 -0.0659021 6.5782 0.197613 6.84167L1.39298 8.03684C1.76247 8.40627 2.24083 8.64777 2.75835 8.7241C3.05148 8.76894 3.28063 8.99805 3.32548 9.29113L5.3095 22.5506C5.39729 23.1387 5.85749 23.5988 6.44567 23.6866L19.7035 25.676C19.9957 25.7199 20.2258 25.95 20.2697 26.2421C20.346 26.7595 20.5876 27.2378 20.9571 27.6073L22.1524 28.8024C22.4159 29.0659 22.8437 29.0659 23.1073 28.8023L24.0622 27.8476C24.3258 27.5841 24.3258 27.1564 24.0623 26.8929C23.4073 26.238 23.415 25.6308 23.8275 25.1668C28.4045 19.8975 28.007 12.8014 23.7144 7.57768C23.4929 7.30848 23.514 6.91515 23.7613 6.66977L24.741 5.69018C25.0046 5.42666 25.4324 5.42663 25.6959 5.6901L26.6917 6.68576C27.2168 7.21461 28.0724 7.21645 28.6014 6.69132C28.8583 6.4364 29.0006 6.08984 28.9996 5.72801L29 1.34981ZM21.8254 22.8633C21.6803 23.081 21.4224 23.1956 21.1637 23.1565L9.73816 21.4524C9.55387 21.4266 9.42594 21.2548 9.45173 21.0705C9.46224 20.9989 9.49567 20.9311 9.54723 20.8796L20.4143 10.0143C20.6759 9.74889 21.1037 9.74504 21.3691 10.0066C21.3901 10.0276 21.4092 10.0486 21.4274 10.0725C24.5322 13.7191 24.6979 19.0291 21.8254 22.8633Z"
                      Fill="{ThemeResource GameTextPrimaryBrush}" />
              </Viewbox>
              <TextBlock Text="{Binding DetailAttackTypeText}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </StackPanel>
        <!-- 右侧分段胜率总结（单处展示，杜绝重复） -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Image Source="{Binding SelectedRankIcon}" Width="20" Height="20" Stretch="Uniform" />
          <TextBlock Text="{Binding DetailRankSummaryText}"
                     Foreground="{ThemeResource CoachGoldBrush}" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- ================= 详情主内容区（左右分栏高屏占比结构） ================= -->
      <Grid Grid.Row="1" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <!-- 左栏：英雄基本信息 + 出装 + 克制 + 小技巧（固定 430px） -->
          <ColumnDefinition Width="430" MinWidth="380" MaxWidth="480" />
          <!-- 右栏：技能与天赋一体化全景控制面板（弹性自适应全部剩余空间） -->
          <ColumnDefinition Width="*" MinWidth="480" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左栏可滚动区域 ============ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      BringIntoViewOnFocusChange="False">
          <StackPanel Spacing="10" Padding="0,0,4,16">

            <!-- 1. 英雄核心概览卡片（头像+血蓝条 + 三维属性 + 攻击/防御/机动性 + 背景故事折叠） -->
            <Border Style="{StaticResource GamePanelStyle}" Padding="12">
              <StackPanel Spacing="10">
                <!-- 顶部：头像血蓝条 + 力量/敏捷/智力 -->
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- 头像与紧贴生命/魔法条 -->
                  <StackPanel Grid.Column="0" Spacing="0">
                    <Border Height="86" CornerRadius="6,6,0,0" Background="{ThemeResource GameSurfaceRaisedBrush}" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1,1,1,0">
                      <Grid>
                        <Image Source="{Binding DetailImage}" Stretch="UniformToFill" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="{Binding DetailAttrBadgeBrush}" CornerRadius="5,0,4,0" Padding="4,2">
                          <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <Image Source="{Binding DetailPrimaryAttributeIcon}" Width="12" Height="12" Stretch="Uniform" />
                            <TextBlock Text="{Binding DetailAttrBadgeText}" Foreground="White" FontSize="9" FontWeight="Bold" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>
                    <!-- 生命条 -->
                    <Border Height="20" Background="#2E7D32" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1,0,1,0" Padding="6,0">
                      <Grid VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeroStatBaseHealth}" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HeroStatHealthRegen}" Foreground="#C8E6C9" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <!-- 魔法条 -->
                    <Border Height="20" Background="#1565C0" CornerRadius="0,0,6,6" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1,0,1,1" Padding="6,0">
                      <Grid VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeroStatBaseMana}" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HeroStatManaRegen}" Foreground="#BBDEFB" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </StackPanel>

                  <!-- 力量/敏捷/智力成长列表 -->
                  <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                    <!-- 力量 -->
                    <Border Background="{ThemeResource GameSurfaceRaisedBrush}" BorderBrush="{Binding PrimaryStrBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3">
                      <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="ms-appx:///Assets/Icons/hero_strength.png" Width="18" Height="18" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="{Binding DetailStrValue}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding DetailStrGrowth}" Foreground="{ThemeResource HeroAttrStrBrush}" FontSize="11" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <!-- 敏捷 -->
                    <Border Background="{ThemeResource GameSurfaceRaisedBrush}" BorderBrush="{Binding PrimaryAgiBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3">
                      <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="ms-appx:///Assets/Icons/hero_agility.png" Width="18" Height="18" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="{Binding DetailAgiValue}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding DetailAgiGrowth}" Foreground="{ThemeResource HeroAttrAgiBrush}" FontSize="11" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <!-- 智力 -->
                    <Border Background="{ThemeResource GameSurfaceRaisedBrush}" BorderBrush="{Binding PrimaryIntBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3">
                      <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="ms-appx:///Assets/Icons/hero_intelligence.png" Width="18" Height="18" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="{Binding DetailIntValue}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding DetailIntGrowth}" Foreground="{ThemeResource HeroAttrIntBrush}" FontSize="11" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Grid>

                <!-- 战斗属性 3 列网格（攻击、防御、机动性） -->
                <Grid ColumnSpacing="6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- 攻击属性 -->
                  <Border Grid.Column="0" Background="{ThemeResource GameSurfaceRaisedBrush}" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5">
                    <StackPanel Spacing="3">
                      <TextBlock Text="攻击" Foreground="{ThemeResource CoachGoldBrush}" FontSize="10" FontWeight="Bold" />
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Icons/icon_damage.png" Width="13" Height="13" Stretch="Uniform" />
                        <TextBlock Text="{Binding HeroStatAttack}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Icons/icon_attack_time.png" Width="13" Height="13" Stretch="Uniform" />
                        <TextBlock Text="{Binding HeroStatAttackRate}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Icons/icon_attack_range.png" Width="13" Height="13" Stretch="Uniform" />
                        <TextBlock Text="{Binding HeroStatAttackRange}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Icons/icon_projectile_speed.png" Width="13" Height="13" Stretch="Uniform" />
                        <TextBlock Text="{Binding HeroStatProjectileSpeed}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- 防御属性 -->
                  <Border Grid.Column="1" Background="{ThemeResource GameSurfaceRaisedBrush}" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5">
                    <StackPanel Spacing="3">
                      <TextBlock Text="防御" Foreground="{ThemeResource CoachGoldBrush}" FontSize="10" FontWeight="Bold" />
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Icons/icon_armor.png" Width="13" Height="13" Stretch="Uniform" />
                        <TextBlock Text="{Binding HeroStatArmor}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Icons/icon_magic_resist.png" Width="13" Height="13" Stretch="Uniform" />
                        <TextBlock Text="{Binding HeroStatMagicResist}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- 机动性 -->
                  <Border Grid.Column="2" Background="{ThemeResource GameSurfaceRaisedBrush}" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5">
                    <StackPanel Spacing="3">
                      <TextBlock Text="机动性" Foreground="{ThemeResource CoachGoldBrush}" FontSize="10" FontWeight="Bold" />
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Icons/icon_movement_speed.png" Width="13" Height="13" Stretch="Uniform" />
                        <TextBlock Text="{Binding HeroStatMoveSpeed}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Icons/icon_turn_rate.png" Width="13" Height="13" Stretch="Uniform" />
                        <TextBlock Text="{Binding HeroStatTurnRate}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Icons/icon_vision.png" Width="13" Height="13" Stretch="Uniform" />
                        <TextBlock Text="{Binding HeroStatVision}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- 英雄一句话介绍与定位标签 -->
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding DetailHypeText}" Foreground="{ThemeResource GameAccentBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding HeroRoleTags}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                          <TextBlock Text="{Binding}" Foreground="{ThemeResource GameTextSecondaryBrush}" FontSize="10" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- 背景故事折叠/展开 -->
                <StackPanel Spacing="2" Visibility="{Binding HasBiography, Converter={StaticResource BoolToVisibilityConverter}}">
                  <TextBlock Text="{Binding DetailBiographyText}" Foreground="{ThemeResource GameTextSecondaryBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap" MaxLines="{Binding BioMaxLines}" />
                  <HyperlinkButton Padding="0" Margin="0,1,0,0" Command="{Binding ToggleBioCommand}" AutomationProperties.Name="{Binding BioToggleText}">
                    <TextBlock Text="{Binding BioToggleText}" Foreground="{ThemeResource GameAccentBrush}" FontSize="11" />
                  </HyperlinkButton>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 2. 推荐出装（显示标准官方中文名，整齐美观） -->
            <Border Visibility="{Binding HasBuilds, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource GamePanelStyle}" Padding="12">
              <StackPanel Spacing="8">
                <Grid>
                  <TextBlock Text="推荐出装" Style="{StaticResource GameSectionTitleStyle}" FontSize="14" />
                  <TextBlock Text="{Binding BuildStatusText}" Foreground="{ThemeResource GameTextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding SelectedBuildGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,2,0,6" Spacing="3">
                        <TextBlock Text="{Binding Name}" Foreground="{ThemeResource GameAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Width="64" Height="52" Margin="0,0,5,5" Background="{ThemeResource GameSurfaceRaisedBrush}" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1" CornerRadius="4" ToolTipService.ToolTip="{Binding StatsText}">
                                <Grid>
                                  <Image Source="{Binding Image}" Width="58" Height="38" Stretch="Uniform" Margin="2" />
                                  <Border VerticalAlignment="Bottom" Background="#E6000000" Padding="2,1">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                  </Border>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- 3. 克制与被克制 -->
            <Border Style="{StaticResource GamePanelStyle}" Padding="12">
              <StackPanel Spacing="8">
                <Grid>
                  <TextBlock Text="克制与被克制" Style="{StaticResource GameSectionTitleStyle}" FontSize="14" />
                  <TextBlock Text="{Binding HeroCountersStatusText}" Foreground="{ThemeResource GameTextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <!-- 优势对阵 -->
                  <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <FontIcon Glyph="&#xE8E1;" FontSize="11" Foreground="{ThemeResource CoachSuccessBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="优势对阵" Foreground="{ThemeResource GameTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding HeroCountersMe}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,4" Background="{ThemeResource GameSurfaceRaisedBrush}" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4">
                            <Grid ColumnSpacing="6">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                              <Image Grid.Column="0" Source="{Binding IconUrl}" Width="26" Height="26" Stretch="Uniform" />
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeroName}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding WinRateText}" Foreground="{ThemeResource CoachSuccessBrush}" FontSize="9" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <!-- 劣势对阵 -->
                  <StackPanel Grid.Column="1" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource CoachDangerBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="劣势对阵" Foreground="{ThemeResource GameTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding HeroCountersTarget}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,4" Background="{ThemeResource GameSurfaceRaisedBrush}" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4">
                            <Grid ColumnSpacing="6">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                              <Image Grid.Column="0" Source="{Binding IconUrl}" Width="26" Height="26" Stretch="Uniform" />
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeroName}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding WinRateText}" Foreground="{ThemeResource CoachDangerBrush}" FontSize="9" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 4. 实战小技巧与机制 -->
            <Border Style="{StaticResource GamePanelStyle}" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock Text="实战小技巧与机制" Style="{StaticResource GameSectionTitleStyle}" FontSize="14" />
                <ItemsControl ItemsSource="{Binding SelectedWikiTips}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{ThemeResource GameSurfaceRaisedBrush}" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,5" CornerRadius="4">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" Foreground="{ThemeResource CoachGoldBrush}" FontSize="11" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Text}" Foreground="{ThemeResource GameTextSecondaryBrush}" FontSize="11" LineHeight="16" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ============ 右栏可滚动区域（技能与天赋全景控制面板） ============ -->
        <ScrollViewer Grid.Column="1" x:Name="HeroDetailHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      BringIntoViewOnFocusChange="False"
                      BringIntoViewRequested="HeroDetailHost_BringIntoViewRequested">
          <StackPanel Spacing="10" Padding="0,0,6,16">

            <!-- 技能与天赋全景卡片（官网 TopAbilitySelector 结构 + 52x52 全覆盖遮罩） -->
            <Border Style="{StaticResource GamePanelStyle}" Padding="14">
              <StackPanel Spacing="10">
                <Grid>
                  <TextBlock Text="技能与天赋" Style="{StaticResource GameSectionTitleStyle}" FontSize="15" />
                </Grid>

                <!-- 横向选择栏（官网标准结构：首项天赋树 + 后续各项技能，带全覆盖遮罩，不展示QWER） -->
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                              BringIntoViewOnFocusChange="False"
                              BringIntoViewRequested="AbilitiesScrollViewer_BringIntoViewRequested">
                  <StackPanel Orientation="Horizontal">
                    <!-- 1. 天赋树图标项（官网左侧首项） -->
                    <Border Margin="0,0,8,0" Padding="3" Width="68" CornerRadius="6"
                            Background="{Binding TalentTileBackgroundBrush}"
                            BorderBrush="{Binding TalentTileBorderBrush}"
                            BorderThickness="{Binding TalentTileBorderThickness}"
                            Opacity="{Binding TalentTileOpacity}"
                            AllowFocusOnInteraction="False"
                            IsTabStop="False"
                            PointerPressed="TalentTile_PointerPressed"
                            ToolTipService.ToolTip="天赋树">
                      <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="6" Background="{ThemeResource GameSurfaceSubtleBrush}" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1">
                          <Image Source="ms-appx:///Assets/Icons/talent_tree.svg" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="天赋树" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" TextAlignment="Center" />
                      </StackPanel>
                    </Border>

                    <!-- 2. 英雄技能图标项列表（带 52x52 官网全覆盖遮罩） -->
                    <ItemsControl ItemsSource="{Binding SelectedAbilities}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,8,0" Padding="3" Width="68" CornerRadius="6"
                                  Background="{Binding SelectionBackgroundBrush}"
                                  BorderBrush="{Binding SelectionBorderBrush}"
                                  BorderThickness="{Binding SelectionBorderThickness}"
                                  Opacity="{Binding SelectionOpacity}"
                                  AllowFocusOnInteraction="False"
                                  IsTabStop="False"
                                  PointerPressed="AbilityTile_PointerPressed"
                                  ToolTipService.ToolTip="{Binding Name}">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                              <Grid Width="52" Height="52">
                                <Border CornerRadius="4">
                                  <Image Source="{Binding Image}" Width="52" Height="52" Stretch="UniformToFill" />
                                </Border>
                                <!-- 官网全覆盖遮罩（SubIcon 覆盖整个 52x52 技能图标） -->
                                <Image Source="{Binding SubIconUrl}" Width="52" Height="52" Stretch="Fill"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding HasSubIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                              </Grid>
                              <TextBlock Text="{Binding Name}" Foreground="{ThemeResource GameTextPrimaryBrush}"
                                         FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="64" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>

                <!-- ============ 天赋树展示面板（当选中天赋树时显示） ============ -->
                <Border Visibility="{Binding IsTalentSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                        MinHeight="220"
                        Background="{ThemeResource GameSurfaceRaisedBrush}"
                        BorderBrush="{ThemeResource GameBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16">
                  <StackPanel Spacing="10">
                    <Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Icons/talent_tree.svg" Width="22" Height="22" Stretch="Uniform" />
                        <TextBlock Text="英雄天赋树" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="15" FontWeight="Bold" />
                      </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding TalentRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid MinHeight="44" Margin="0,3" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="44" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 左侧分支 -->
                            <Border Grid.Column="0" Background="{ThemeResource TalentNodeBackgroundBrush}"
                                    BorderBrush="{ThemeResource TalentNodeBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,6">
                              <TextBlock Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center">
                                <Run Text="{Binding Left.NumberPrefix}" Foreground="{ThemeResource CoachGoldLightBrush}" FontWeight="Bold" /><Run Text=" " /><Run Text="{Binding Left.Label}" />
                              </TextBlock>
                            </Border>
                            <!-- 中间等级圆圈 -->
                            <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19"
                                    Background="{ThemeResource TalentLevelBadgeBrush}"
                                    BorderBrush="{ThemeResource TalentLevelTextBrush}" BorderThickness="1.5">
                              <TextBlock Text="{Binding Level}" Foreground="{ThemeResource TalentLevelTextBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- 右侧分支 -->
                            <Border Grid.Column="2" Background="{ThemeResource TalentNodeBackgroundBrush}"
                                    BorderBrush="{ThemeResource TalentNodeBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,6">
                              <TextBlock Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center">
                                <Run Text="{Binding Right.NumberPrefix}" Foreground="{ThemeResource CoachGoldLightBrush}" FontWeight="Bold" /><Run Text=" " /><Run Text="{Binding Right.Label}" />
                              </TextBlock>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- ============ 技能详情展示面板（当选中具体技能时显示） ============ -->
                <Border Visibility="{Binding IsTalentSelected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                        MinHeight="220"
                        Background="{ThemeResource GameSurfaceRaisedBrush}"
                        BorderBrush="{ThemeResource GameBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14"
                        BringIntoViewRequested="SelectedAbilityPanel_BringIntoViewRequested">
                  <StackPanel Spacing="10">
                    <!-- 1. AbilityMain: 大图标 + 技能名 + 技能正文描述 -->
                    <Grid ColumnSpacing="14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <!-- 大技能图标（60x60，带全覆盖遮罩） -->
                      <Grid Grid.Column="0" Width="60" Height="60" VerticalAlignment="Top">
                        <Border CornerRadius="6">
                          <Image Source="{Binding CurrentAbility.Image}" Width="60" Height="60" Stretch="UniformToFill" />
                        </Border>
                        <Image Source="{Binding CurrentAbility.SubIconUrl}" Width="60" Height="60" Stretch="Fill"
                               IsHitTestVisible="False"
                               Visibility="{Binding CurrentAbility.HasSubIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                      </Grid>

                      <!-- 技能名称、类型标签与正文描述 -->
                      <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Text="{Binding CurrentAbility.Name}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="18" FontWeight="Bold" />
                          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentAbility.AbilityVariantType}" Foreground="{ThemeResource GameAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                          </Border>
                        </StackPanel>
                        <!-- 技能描述文本（所有参数精准解析，无无效占位符与代码垃圾） -->
                        <TextBlock Text="{Binding CurrentAbility.Description}"
                                   Foreground="{ThemeResource GameTextPrimaryBrush}"
                                   FontSize="13" LineHeight="20" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>

                    <!-- 2. GenericValues: 官网两列通用机制属性 -->
                    <Border Background="{ThemeResource GameSurfaceSubtleBrush}" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8">
                      <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Column 0: 技能目标 + 伤害类型 -->
                        <StackPanel Grid.Column="0" Spacing="4">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="技能:" Foreground="{ThemeResource GameTextMutedBrush}" FontSize="11" Width="65" />
                            <TextBlock Text="{Binding CurrentAbility.TargetTypeText}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="伤害类型:" Foreground="{ThemeResource GameTextMutedBrush}" FontSize="11" Width="65" />
                            <TextBlock Text="{Binding CurrentAbility.DamageTypeText}" Foreground="{ThemeResource CoachDangerBrush}" FontSize="11" FontWeight="Bold" />
                          </StackPanel>
                        </StackPanel>
                        <!-- Column 1: 无视减益免疫 + 可以驱散 -->
                        <StackPanel Grid.Column="1" Spacing="4">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="无视减益免疫:" Foreground="{ThemeResource GameTextMutedBrush}" FontSize="11" Width="90" />
                            <TextBlock Text="{Binding CurrentAbility.SpellImmunityText}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="可以驱散:" Foreground="{ThemeResource GameTextMutedBrush}" FontSize="11" Width="90" />
                            <TextBlock Text="{Binding CurrentAbility.DispellableText}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- 3. SpecificValues: 官网键值特殊参数网格（已过滤所有全0垃圾项与内部元数据） -->
                    <ItemsControl ItemsSource="{Binding CurrentAbility.StatsDetails}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Width="220" Margin="0,0,8,6" Padding="8,4" Background="{ThemeResource GameSurfaceSubtleBrush}" BorderBrush="{ThemeResource GameBorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="{Binding Label}" Foreground="{ThemeResource GameTextMutedBrush}" FontSize="11" />
                              <TextBlock Text="{Binding Value}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 4. BottomValues: 官网冷却与魔法消耗条 -->
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding CurrentAbility.CooldownText, Converter={StaticResource EmptyToCollapsedConverter}}" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Icons/cooldown.png" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentAbility.Cooldown}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding CurrentAbility.ManaCostText, Converter={StaticResource EmptyToCollapsedConverter}}" VerticalAlignment="Center">
                        <Border Width="15" Height="15" Background="#1E88E5" CornerRadius="3" VerticalAlignment="Center">
                          <TextBlock Text="M" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding CurrentAbility.ManaCost}" Foreground="#90CAF9" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>

                    <!-- 5. 当前技能神杖升级说明（使用原版物品图标 ultimate_scepter.png，固定蓝青色 #2196F3，无背景色框） -->
                    <StackPanel Visibility="{Binding CurrentAbility.HasScepterUpgradeText, Converter={StaticResource BoolToVisibilityConverter}}"
                                Spacing="4" Margin="0,4,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Icons/ultimate_scepter.png" Width="26" Height="19" Stretch="Uniform" />
                        <TextBlock Text="阿哈利姆神杖升级" Foreground="#2196F3" FontSize="13" FontWeight="Bold" />
                      </StackPanel>
                      <TextBlock Text="{Binding CurrentAbility.Scepter}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="34,0,0,0" />
                    </StackPanel>

                    <!-- 6. 当前技能魔晶升级说明（使用原版物品图标 aghanims_shard.png，固定紫罗兰色 #AB47BC，无背景色框） -->
                    <StackPanel Visibility="{Binding CurrentAbility.HasShardUpgradeText, Converter={StaticResource BoolToVisibilityConverter}}"
                                Spacing="4" Margin="0,4,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Icons/aghanims_shard.png" Width="26" Height="19" Stretch="Uniform" />
                        <TextBlock Text="阿哈利姆魔晶升级" Foreground="#AB47BC" FontSize="13" FontWeight="Bold" />
                      </StackPanel>
                      <TextBlock Text="{Binding CurrentAbility.Shard}" Foreground="{ThemeResource GameTextPrimaryBrush}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="34,0,0,0" />
                    </StackPanel>

                    <!-- 7. 备注与背景故事（Lore） -->
                    <TextBlock Text="{Binding CurrentAbility.Lore}" Foreground="{ThemeResource GameTextMutedBrush}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                               Visibility="{Binding CurrentAbility.Lore, Converter={StaticResource EmptyToCollapsedConverter}}" />
                    <ItemsControl ItemsSource="{Binding CurrentAbility.Notes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" Foreground="{ThemeResource GameTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Page>
