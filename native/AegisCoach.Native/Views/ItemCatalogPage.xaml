<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AegisCoach.Native.Views.ItemCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:models="using:AegisCoach.Native.Models"
    xmlns:viewmodels="using:AegisCoach.Native.ViewModels"
    Unloaded="Page_Unloaded">

  <Grid x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Padding="16,10,16,12" RowSpacing="8">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="ResponsiveStates">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1100" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Compact">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="RootGrid.Padding" Value="10,8,10,10" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Row 0：单行高密度分类顶栏（商店/中立切换 + 子类多选筛选 Chips + 统计 + 刷新） ===== -->
    <Grid Grid.Row="0" ColumnSpacing="12" MinHeight="36" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- 商店物品 / 中立物品切换 -->
      <RadioButtons Grid.Column="0" MaxColumns="2" VerticalAlignment="Center"
                    SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
                    AutomationProperties.Name="物品分类切换">
        <x:String>商店物品</x:String>
        <x:String>中立物品</x:String>
      </RadioButtons>

      <!-- 子类多选筛选 Chips（水平单行流动，隐藏滚动条） -->
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                    VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding SubCategoryFilters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Style="{StaticResource FilterChipStyle}" Margin="0,2,6,2"
                            AutomationProperties.Name="{Binding Name}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 顶部工具栏右侧：统计数量（刷新功能统一由顶部标题栏承担） -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{Binding CountText}" Margin="2,0" FontSize="11"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

        <!-- 隐藏占位搜索框（代码后向兼容） -->
        <AutoSuggestBox x:Name="SearchBox" Visibility="Collapsed" />
      </StackPanel>
    </Grid>

    <!-- ===== Row 1：内容区（loading / error / empty / 分组网格） ===== -->
    <Grid Grid.Row="1">

      <!-- 加载态 -->
      <StackPanel x:Name="LoadingPanel" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
        <ProgressRing IsActive="{Binding IsLoading}" Width="36" Height="36" />
        <TextBlock Text="正在同步物品数据…" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- 错误态：靠近内容区并提供重试动作 -->
      <InfoBar x:Name="ErrorBar" IsOpen="{Binding HasError}" Severity="Error" IsClosable="False"
               HorizontalAlignment="Center" MaxWidth="680" VerticalAlignment="Top"
               Title="无法加载物品数据" Message="{Binding ErrorMessage}">
        <InfoBar.ActionButton>
          <Button Content="重试" Command="{Binding LoadCommand}" />
        </InfoBar.ActionButton>
      </InfoBar>

      <!-- 空结果态 -->
      <StackPanel x:Name="EmptyPanel" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
        <FontIcon Glyph="&#xE721;" FontSize="30" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                  HorizontalAlignment="Center" />
        <TextBlock Text="没有匹配的物品，试试调整搜索或筛选" FontSize="13"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- 分组物品网格：大分类 -> 子分类 -> 物品图标网格。
           注意：WinUI 3 的 ItemsControl.GroupStyle 不会应用 ItemsControl.ItemTemplate（分组内物品
           会按默认 ToString 渲染成类型名，导致“全是代码”），因此这里改为手动分组：
           外层 ItemsControl 枚举 Groups，每个 ItemGroup 用嵌套 ItemsControl 渲染自己的物品。 -->
      <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <!-- 分组头：SectionLabel 标签 + 分类名 + 数量 -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,6">
                  <Border Width="4" Height="18" Background="{ThemeResource SystemAccentColor}" CornerRadius="2" />
                  <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                    <TextBlock Text="{Binding SectionLabel}" FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </Border>
                  <TextBlock Text="{Binding Key}" FontSize="15" FontWeight="SemiBold"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                  <TextBlock Text="{Binding Count}" FontSize="11"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 物品图标网格：DataContext 为 ItemGroup（List<CatalogItem>） -->
                <ItemsControl ItemsSource="{Binding}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource ItemTileStyle}" Margin="0,0,6,6"
                              AutomationProperties.Name="{Binding Name}"
                              PointerEntered="Tile_PointerEntered"
                              PointerMoved="Tile_PointerMoved"
                              PointerExited="Tile_PointerExited">
                        <!-- 图标素材为 88x62 横长图，格子同比例且零边距，图片直接铺满不留白（悬浮详情由窗口内 Popup 提供） -->
                        <Image Source="{Binding IconUrl}" Stretch="Uniform" Margin="0" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- 悬浮详情卡：窗口内 Popup（屏幕坐标定位并夹取到窗口矩形内，避免超出应用/屏幕边缘）。
         内容复用 ItemDetailCardTemplate，DataContext 由 ContentControl.Content 提供。 -->
    <Popup x:Name="DetailPopup"
           IsLightDismissEnabled="False"
           HorizontalOffset="0" VerticalOffset="0">
      <ContentControl x:Name="DetailPopupContent"
                      ContentTemplate="{StaticResource ItemDetailCardTemplate}"
                      PointerEntered="DetailPopup_PointerEntered"
                      PointerExited="DetailPopup_PointerExited" />
    </Popup>
  </Grid>
</Page>
