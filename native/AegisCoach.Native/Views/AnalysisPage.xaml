<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AegisCoach.Native.Views.AnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AegisCoach.Core.Models"
    mc:Ignorable="d"
    SizeChanged="AnalysisPage_SizeChanged">

  <Grid x:Name="AnalysisRootGrid" Padding="24,18,24,22" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 顶栏：标题与 API 快速拉取 -->
    <Grid Grid.Row="0" RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="赛后分析" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ReportCountText}" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,2" />
        </StackPanel>
        <TextBlock Text="游戏习惯记录 + AI 复盘 · 数据来自本地 GSI 快照，不依赖网络也可出规则摘要" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" />
      </StackPanel>

      <StackPanel x:Name="AnalysisImportPanel" Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
        <TextBox x:Name="MatchIdBox" Text="{Binding MatchIdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="170" Height="32" PlaceholderText="输入比赛 ID" />
        <Button Content="从 API 拉取复盘" Command="{Binding FetchMatchCommand}" IsEnabled="{Binding IsFetchingMatch, Converter={StaticResource BoolToVisibilityConverter}}" Height="32" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Height="1" Background="{ThemeResource BorderBrush}" Margin="0,2,0,2" />

    <!-- 历史习惯概要横幅 -->
    <Border Grid.Row="2" Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12,8">
      <TextBlock Text="{Binding HabitsSummaryText}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
    </Border>

    <!-- 主展示区：左侧报告列表 + 右侧详情 -->
    <Grid Grid.Row="3" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="AnalysisListColumn" Width="330" MinWidth="280" />
        <ColumnDefinition x:Name="AnalysisDetailColumn" Width="*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <!-- 报告列表 -->
      <ListView x:Name="ReportsListView" Grid.Column="0" ItemsSource="{Binding AnalysisReports}" SelectedItem="{Binding SelectedSummary, Mode=TwoWay}" SelectionMode="Single" SelectionChanged="ReportsListView_SelectionChanged" Background="Transparent">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border Background="{ThemeResource PanelBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10,8">
              <StackPanel Spacing="2">
                <Grid>
                  <TextBlock Text="{Binding Match.HeroName}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <Border HorizontalAlignment="Right" Padding="6,1" CornerRadius="2" Background="{Binding Match.Won, Converter={StaticResource ResultToBrushConverter}}">
                    <TextBlock Text="{Binding Match.ResultText}" Foreground="{ThemeResource OnAccentBrush}" FontSize="9" FontWeight="SemiBold" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding Match.SummaryLine}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10">
                  <Run Text="{Binding GeneratedText}" /><Run Text=" · " /><Run Text="{Binding Backend}" />
                </TextBlock>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <!-- 详情卡片面板 -->
      <Border x:Name="AnalysisDetailPanel" Grid.Column="1" Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" Background="{ThemeResource PanelBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="3">
        <Grid>
          <!-- 初始空状态 -->
          <StackPanel x:Name="AnalysisEmptyState" Visibility="{Binding SelectedSummary, Converter={StaticResource EmptyToCollapsedConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <FontIcon Glyph="&#xE8A5;" FontSize="28" Foreground="{ThemeResource TertiaryTextBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="选择左侧报告查看复盘详情" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="12" />
          </StackPanel>

          <!-- 详情内容或加载/错误状态 -->
          <Grid x:Name="AnalysisDetailRoot" Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部操作条（返回/关闭） -->
            <Grid Grid.Row="0" Margin="12,10,12,6">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource GameIconButtonStyle}" Command="{Binding CloseDetailCommand}" ToolTipService.ToolTip="关闭复盘详情" AutomationProperties.Name="关闭复盘详情">
                  <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock Text="复盘详情" Foreground="{ThemeResource GameTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <!-- 加载或错误状态占位 -->
            <Grid Grid.Row="1" Visibility="{Binding IsDetailStateVisible, Converter={StaticResource BoolToVisibilityConverter}}" Padding="24">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <ProgressRing IsActive="{Binding IsLoadingDetail}" Visibility="{Binding IsLoadingDetail, Converter={StaticResource BoolToVisibilityConverter}}" Width="32" Height="32" />
                <TextBlock Text="{Binding DetailStateTitle}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DetailStateMessage}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" />
              </StackPanel>
            </Grid>

            <!-- 完整复盘内容 ScrollViewer -->
            <ScrollViewer Grid.Row="1" x:Name="AnalysisDetailHost" Visibility="{Binding IsDetailContentVisible, Converter={StaticResource BoolToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False">
              <StackPanel Padding="18,16" Spacing="8">
                <TextBlock Text="{Binding DetailTitleText}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DetailMetaText}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DetailBackendText}" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10" />
                <Border BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,2" />

                <!-- AI 复盘卡片 -->
                <Grid>
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE90A;" FontSize="14" Foreground="{ThemeResource CoachGoldBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="AI 复盘" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" />
                  </StackPanel>
                  <Button Content="重新生成复盘" Command="{Binding RegenerateReviewCommand}" HorizontalAlignment="Right" Padding="10,4" FontSize="11" />
                </Grid>
                <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12">
                  <TextBlock Text="{Binding DetailReviewText}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" LineHeight="20" TextWrapping="Wrap" />
                </Border>

                <!-- 最终装备 -->
                <TextBlock Text="最终装备" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Text="{Binding DetailItemsText}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />

                <!-- 关键节点 -->
                <TextBlock Text="关键节点" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12">
                  <TextBlock Text="{Binding DetailMomentsText}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
                </Border>

                <!-- 经济曲线 -->
                <TextBlock Text="经济曲线（每 5 分钟采样）" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Text="{Binding DetailEconomyText}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />

                <!-- 回放操作记录 -->
                <TextBlock Text="回放操作记录（GSI 提取）" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12">
                  <StackPanel>
                    <TextBlock Text="本局没有回放记录，无法提取操作。请确认 GSI 快照记录已开启后，点击“重新生成复盘”。" Visibility="{Binding HasOperations, Converter={StaticResource EmptyToCollapsedConverter}}" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailOperationsText}" Visibility="{Binding HasOperations, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <!-- 整场数据（OpenDota） -->
                <TextBlock Text="整场数据（OpenDota）" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12">
                  <StackPanel>
                    <TextBlock Text="未拉取 OpenDota 整场数据。可在页面右上角输入比赛 ID 拉取，或点击“重新生成复盘”重试。" Visibility="{Binding HasApiData, Converter={StaticResource EmptyToCollapsedConverter}}" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailApiText}" Visibility="{Binding HasApiData, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
