<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AegisCoach.Native.Views.CoachPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:AegisCoach.Native.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewModels:CoachViewModel}"
    SizeChanged="CoachPage_SizeChanged">

  <ScrollViewer x:Name="CoachScrollViewer" Padding="24,18,24,22"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="CoachLayout" RowSpacing="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 1. 顶部状态条（电竞战术控制台风格） -->
      <Border Grid.Row="0" Background="{ThemeResource CoachPanelTintBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
        <Grid x:Name="CoachStatusGrid" ColumnSpacing="16" RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- 左侧：GSI 状态与指示呼吸灯 -->
          <StackPanel x:Name="CoachStatusLeft" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <!-- 发光光晕 -->
              <Ellipse Width="16" Height="16" Fill="{ThemeResource CoachSuccessBrush}" Opacity="0.25"
                       Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}" />
              <!-- 核心状态圆点 -->
              <Ellipse x:Name="CoachStatusDot" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Fill="{Binding IsConnected, Converter={StaticResource ResultToBrushConverter}}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="GSI 实时状态：" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="{Binding StatusText}" Foreground="{ThemeResource CoachGoldLightBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <!-- 中间：对局态势概览（阶段、时间、比分、昼夜、建筑） -->
          <StackPanel x:Name="CoachOverviewPanel" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Border Width="1" Height="16" Background="{ThemeResource SubtleBorderBrush}" />
            <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="{ThemeResource CoachGoldBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding OverviewText}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 右侧：提醒计数徽章与快捷操作 -->
          <StackPanel x:Name="CoachActionsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <FontIcon Glyph="&#xE90A;" FontSize="12" Foreground="{ThemeResource CoachGoldBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding AdviceCountText}" Foreground="{ThemeResource CoachGoldLightBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Button Content="设置" Command="{Binding OpenSettingsCommand}" CornerRadius="6" Padding="12,5"
                    ToolTipService.ToolTip="打开教练与 GSI 设置" AutomationProperties.Name="打开教练与 GSI 设置" />
            <Button Content="清空" Command="{Binding ClearAdvicesCommand}" CornerRadius="6" Padding="12,5"
                    ToolTipService.ToolTip="清空当前提醒列表" AutomationProperties.Name="清空当前提醒列表" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 2. 主区域：我的英雄面板 + 实时教练提醒 -->
      <Grid x:Name="CoachPrimaryGrid" Grid.Row="1" ColumnSpacing="14" RowSpacing="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.95*" MinWidth="320" />
          <ColumnDefinition Width="1.05*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- 我的英雄面板 (在对局中展示 HUD，未进入对局展示友好的待机引导) -->
        <Border x:Name="CoachHeroPanel" Grid.Column="0"
                Visibility="{Binding IsHeroPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{ThemeResource CoachPanelTintBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
          <Grid>
            <!-- 状态 A：已进入对局，展示英雄完整 HUD -->
            <StackPanel Spacing="12" Visibility="{Binding HasHeroData, Converter={StaticResource BoolToVisibilityConverter}}">
              <!-- 标题行 -->
              <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{ThemeResource CoachGoldBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="我的英雄" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" />
                  <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="GSI 实时状态" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10" />
                  </Border>
                </StackPanel>
              </Grid>

              <!-- 头像 + 核心血蓝条 -->
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="96" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 英雄头像框 -->
                <Grid Grid.Column="0" Width="96" Height="96">
                  <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource CoachGoldBrush}" BorderThickness="2" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Image Source="{Binding HeroImage}" Stretch="Uniform" />
                  </Border>
                  <!-- 等级角标 -->
                  <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#E6101010" BorderBrush="{ThemeResource CoachGoldBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,5,5">
                    <TextBlock Text="{Binding HeroLevelText}" Foreground="{ThemeResource CoachGoldLightBrush}" FontSize="11" FontWeight="Bold" />
                  </Border>
                </Grid>

                <!-- 英雄名称与血蓝数值 -->
                <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                  <TextBlock Text="{Binding HeroName}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                  <!-- 生命值条 -->
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="生命" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Value="{Binding HeroHp}" Maximum="{Binding HeroMaxHp}" Height="12" CornerRadius="4" VerticalAlignment="Center" Foreground="{ThemeResource CoachDangerBrush}" Background="{ThemeResource SubtlePanelBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding HeroHpText}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="96" TextAlignment="Right" />
                  </Grid>

                  <!-- 魔法值条 -->
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="魔法" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Value="{Binding HeroMana}" Maximum="{Binding HeroMaxMana}" Height="12" CornerRadius="4" VerticalAlignment="Center" Foreground="{ThemeResource CoachInfoBlueBrush}" Background="{ThemeResource SubtlePanelBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding HeroManaText}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="96" TextAlignment="Right" />
                  </Grid>
                </StackPanel>
              </Grid>

              <!-- 4 项战术指标胶囊卡片 -->
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- KDA -->
                <Border Grid.Column="0" Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="K / D / A" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding HeroKdaText}" Foreground="{ThemeResource CoachGoldLightBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>

                <!-- 金钱与正补 -->
                <Border Grid.Column="1" Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="金钱 / 补刀" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding HeroGoldText}" Foreground="{ThemeResource CoachGoldBrush}" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock Text="·" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="12" />
                      <TextBlock Text="{Binding HeroLastHitsText}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- GPM / XPM -->
                <Border Grid.Column="2" Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="GPM / XPM" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding HeroGpmText}" Foreground="{ThemeResource CoachSuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock Text="/" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="12" />
                      <TextBlock Text="{Binding HeroXpmText}" Foreground="{ThemeResource CoachInfoBlueBrush}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- 装备栏展示 -->
              <StackPanel Spacing="6" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="当前装备" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="（主背包 6 格 · 悬停可看详细道具名）" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding HeroItems}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="46" Height="46" Margin="0,0,7,6" Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                        <Image Source="{Binding Image}" ToolTipService.ToolTip="{Binding Name}" Stretch="Uniform" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <!-- 状态 B：未进对局时的优雅待机卡片 -->
            <StackPanel Visibility="{Binding HasHeroData, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Padding="16,36">
              <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource CoachGoldDarkBrush}" BorderThickness="1" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE7FC;" FontSize="28" Foreground="{ThemeResource CoachGoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="等待 Dota 2 对局载入" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="启动 Dota 2 并进入游戏后，此处将自动同步英雄生命、魔法、补刀与 6 格实时装备。"
                           Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="280" />
              </StackPanel>
              <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center">
                <TextBlock Text="GSI 监听运行中 · 随时就绪" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="11" />
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 教练提醒面板 -->
        <Border x:Name="CoachAdvicePanel" Grid.Column="1" Background="{ThemeResource CoachPanelTintBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
          <StackPanel Spacing="10">
            <Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE90A;" FontSize="15" Foreground="{ThemeResource CoachGoldBrush}" VerticalAlignment="Center" />
                <TextBlock Text="战术教练提醒" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" />
                <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock Text="规则引擎实时触发 · 毫秒级战术诊断" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10" />
                </Border>
              </StackPanel>
            </Grid>

            <!-- 状态 A：有提醒时展示提醒列表 -->
            <ListView x:Name="AdviceList" ItemsSource="{Binding Advices}" Visibility="{Binding HasAdvices, Converter={StaticResource BoolToVisibilityConverter}}"
                      SelectionMode="None" BorderThickness="0" Padding="0" MaxHeight="540" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,10">
                    <!-- 左侧严重度色条 -->
                    <Border Width="4" HorizontalAlignment="Left" Background="{Binding Severity, Converter={StaticResource SeverityBrushConverter}}" CornerRadius="2" />
                    <!-- 内容卡片 -->
                    <Border Margin="8,0,0,0" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" Background="{ThemeResource SubtlePanelBrush}" CornerRadius="6" Padding="14,10">
                      <StackPanel Spacing="5">
                        <Grid>
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border Background="{Binding Severity, Converter={StaticResource SeverityBrushConverter}}" Padding="6,2" CornerRadius="4">
                              <TextBlock Text="{Binding SeverityText}" Foreground="{ThemeResource OnAccentBrush}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding Title}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Border Background="{ThemeResource CoachPanelTintBrush}" CornerRadius="4" Padding="6,1">
                              <TextBlock Text="{Binding GameTimeText}" Foreground="{ThemeResource CoachGoldBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding TimeText}" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10" VerticalAlignment="Center" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Message}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,2,0,0" />
                        <!-- 证据胶囊 -->
                        <Border Background="{ThemeResource CoachPanelTintBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,4,0,0">
                          <TextBlock Text="{Binding FriendlyEvidenceText}" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                        </Border>
                      </StackPanel>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <!-- 状态 B：无提醒时的舒缓空状态卡片 -->
            <StackPanel Visibility="{Binding HasAdvices, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Padding="16,42">
              <Border Width="52" Height="52" CornerRadius="26" Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource CoachSuccessBrush}" BorderThickness="1" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8FB;" FontSize="24" Foreground="{ThemeResource CoachSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="战术态势平稳 · 暂无预警" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="神盾教练规则引擎正在后台监控对局态势。当检测到克制威胁、装备缺口或走位风险时将在此即时提醒。"
                           Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="320" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 3. 全场阵容与大数据推荐出装 -->
      <Border Grid.Row="2" Background="{ThemeResource CoachPanelTintBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
        <Grid x:Name="CoachRosterGrid" ColumnSpacing="18" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="180" />
            <ColumnDefinition Width="1*" MinWidth="180" />
            <ColumnDefinition Width="1.3*" MinWidth="260" />
          </Grid.ColumnDefinitions>

          <!-- 我方阵容 -->
          <StackPanel x:Name="CoachAlliesPanel" Grid.Column="0" Spacing="8" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE716;" FontSize="14" Foreground="{ThemeResource CoachSuccessBrush}" VerticalAlignment="Center" />
              <TextBlock Text="我方英雄" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="{Binding AllyHeroesCountText}" Foreground="{ThemeResource CoachSuccessBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <!-- 英雄列表 -->
            <ItemsControl ItemsSource="{Binding AllyHeroes}" Visibility="{Binding HasAllyHeroes, Converter={StaticResource BoolToVisibilityConverter}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,6,6" Padding="4,4,8,4" Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Width="26" Height="26" CornerRadius="4">
                        <Image Source="{Binding IconUrl}" Width="26" Height="26" Stretch="Uniform" />
                      </Border>
                      <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 空状态占位 -->
            <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,14"
                    Visibility="{Binding HasAllyHeroes, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
              <TextBlock Text="等待我方英雄选人数据…" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="11" HorizontalAlignment="Center" />
            </Border>
          </StackPanel>

          <!-- 敌方阵容 -->
          <StackPanel x:Name="CoachEnemiesPanel" Grid.Column="1" Spacing="8" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE716;" FontSize="14" Foreground="{ThemeResource CoachDangerBrush}" VerticalAlignment="Center" />
              <TextBlock Text="敌方英雄" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="{Binding EnemyHeroesCountText}" Foreground="{ThemeResource CoachDangerBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <!-- 英雄列表 -->
            <ItemsControl ItemsSource="{Binding EnemyHeroes}" Visibility="{Binding HasEnemyHeroes, Converter={StaticResource BoolToVisibilityConverter}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,6,6" Padding="4,4,8,4" Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Width="26" Height="26" CornerRadius="4">
                        <Image Source="{Binding IconUrl}" Width="26" Height="26" Stretch="Uniform" />
                      </Border>
                      <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 空状态占位 -->
            <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,14"
                    Visibility="{Binding HasEnemyHeroes, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
              <TextBlock Text="等待敌方英雄选人数据…" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="11" HorizontalAlignment="Center" />
            </Border>
          </StackPanel>

          <!-- 大数据推荐出装 -->
          <StackPanel x:Name="CoachRecommendationPanel" Grid.Column="2" Spacing="8" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE719;" FontSize="14" Foreground="{ThemeResource CoachGoldBrush}" VerticalAlignment="Center" />
              <TextBlock Text="推荐出装（大数据与胜率模型）" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="{Binding HeroesStatusText}" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
            <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
              <TextBlock Text="{Binding ItemRecommendText}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="19" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 4. 克制与被克制分析 · 选人推荐 -->
      <Border Grid.Row="3" Background="{ThemeResource CoachPanelTintBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
        <StackPanel Spacing="10">
          <Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE7FC;" FontSize="15" Foreground="{ThemeResource CoachGoldBrush}" VerticalAlignment="Center" />
              <TextBlock Text="克制对位 · 选人与对阵策略" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CounterStatusText}" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <Grid x:Name="CoachCounterGrid" ColumnSpacing="18" RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" MinWidth="200" />
              <ColumnDefinition Width="1*" MinWidth="200" />
              <ColumnDefinition Width="1*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- 敌方克制我 -->
            <StackPanel x:Name="CoachCounterRiskPanel" Grid.Column="0" Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource CoachDangerBrush}" VerticalAlignment="Center" />
                <TextBlock Text="敌方克制我" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,1">
                  <TextBlock Text="对阵胜率 ≤48%" Foreground="{ThemeResource CoachDangerBrush}" FontSize="10" />
                </Border>
              </StackPanel>
              <!-- 列表 -->
              <ItemsControl ItemsSource="{Binding CountersMe}" Visibility="{Binding HasCountersMe, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,6,6" Padding="6" Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding IconUrl}" Width="32" Height="32" Stretch="Uniform" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding HeroName}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding WinRateText}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource CoachDangerBrush}" />
                            <TextBlock Text="{Binding SampleText}" FontSize="9" Foreground="{ThemeResource TertiaryTextBrush}" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- 空状态占位 -->
              <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,14"
                      Visibility="{Binding HasCountersMe, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                <TextBlock Text="暂无显著被克制英雄" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="11" HorizontalAlignment="Center" />
              </Border>
            </StackPanel>

            <!-- 我克制敌方 -->
            <StackPanel x:Name="CoachCounterAdvantagePanel" Grid.Column="1" Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE8E1;" FontSize="14" Foreground="{ThemeResource CoachSuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text="我克制敌方" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,1">
                  <TextBlock Text="对阵胜率 ≥52%" Foreground="{ThemeResource CoachSuccessBrush}" FontSize="10" />
                </Border>
              </StackPanel>
              <!-- 列表 -->
              <ItemsControl ItemsSource="{Binding CountersTarget}" Visibility="{Binding HasCountersTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,6,6" Padding="6" Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding IconUrl}" Width="32" Height="32" Stretch="Uniform" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding HeroName}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding WinRateText}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource CoachSuccessBrush}" />
                            <TextBlock Text="{Binding SampleText}" FontSize="9" Foreground="{ThemeResource TertiaryTextBrush}" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- 空状态占位 -->
              <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,14"
                      Visibility="{Binding HasCountersTarget, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                <TextBlock Text="暂无显著优势对位英雄" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="11" HorizontalAlignment="Center" />
              </Border>
            </StackPanel>

            <!-- 选人推荐 -->
            <StackPanel x:Name="CoachCounterPickPanel" Grid.Column="2" Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE716;" FontSize="14" Foreground="{ThemeResource CoachGoldBrush}" VerticalAlignment="Center" />
                <TextBlock Text="选人推荐（阵容胜率优化）" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
              </StackPanel>
              <!-- 列表 -->
              <ItemsControl ItemsSource="{Binding PickRecommendations}" Visibility="{Binding HasPickRecommendations, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="180" Margin="0,0,6,6" Padding="6" Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="36" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding IconUrl}" Width="36" Height="36" Stretch="Uniform" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding HeroName}" FontSize="11" Foreground="{ThemeResource PrimaryTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding SummaryText}" FontSize="9" Foreground="{ThemeResource TertiaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- 空状态占位 -->
              <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,14"
                      Visibility="{Binding HasPickRecommendations, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                <TextBlock Text="等待敌我双方阵容确定后推荐" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="11" HorizontalAlignment="Center" />
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Page>
