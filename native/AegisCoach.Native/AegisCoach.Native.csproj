<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AegisCoach.Native</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CommunityToolkit.Mvvm 8.4+ 在 WinUI 3 推荐 partial property 形式的 [ObservableProperty]（CsWinRT/AOT 兼容），需要 C# 13。 -->
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.2.12" />
    <PackageReference Include="JYPPX.OpenVINO.CSharp.API" Version="3.3.1" />
    <PackageReference Include="JYPPX.OpenVINO.GenAI.runtime.win" Version="2026.3.0" />
  </ItemGroup>

  <!-- WinUI 3 未打包应用 publish 时不会自动复制 .xbf/.pri 资源，这里在发布后从构建输出补齐
       （含 Views/Themes 子目录，新增页面/主题自动覆盖），否则发布版 exe 因缺少 XAML 编译资源而启动即退出。 -->
  <Target Name="CopyWinUIResourcesForPublish" AfterTargets="Publish">
    <Exec Command="powershell -NoProfile -Command &quot;$out = '$(OutputPath)'; $pub = '$(PublishDir)'; Get-ChildItem $out -Recurse -Include '*.xbf','*.pri' | ForEach-Object { $rel = $_.FullName.Substring($out.Length); $dest = Join-Path $pub $rel; $dir = Split-Path $dest -Parent; if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }; Copy-Item $_.FullName $dest -Force }&quot;" />
  </Target>

  <!-- 发布版只保留简体中文与英文界面资源，删除其余 70+ 语言目录，减小分发体积。 -->
  <Target Name="TrimPublishLanguages" AfterTargets="CopyWinUIResourcesForPublish">
    <Exec Command="powershell -NoProfile -Command &quot;Get-ChildItem '$(PublishDir)' -Directory | Where-Object { $_.Name -match '^[a-z]{2,3}(-[A-Za-z0-9]{2,4})+$' -and $_.Name -notin @('zh-CN','en-us') } | Remove-Item -Recurse -Force&quot;" />
  </Target>

</Project>

