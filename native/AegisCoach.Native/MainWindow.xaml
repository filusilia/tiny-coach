<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AegisCoach.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:local="using:AegisCoach.Native.Converters"
    xmlns:views="using:AegisCoach.Native.Views"
    Title="神盾教练">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}" SizeChanged="RootGrid_SizeChanged" KeyDown="RootGrid_KeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ================= 顶层自定义标题栏 (参考图吧工具箱 WinUI 3 标准规范) ================= -->
    <TitleBar
        x:Name="AppTitleBar"
        Grid.Row="0"
        Height="48"
        Title="神盾教练"
        FontWeight="Bold"
        IsBackButtonVisible="False"
        IsPaneToggleButtonVisible="True"
        PaneToggleRequested="TitleBar_PaneToggleRequested">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="ms-appx:///Assets/Icons/app_256.png" />
      </TitleBar.IconSource>
      <TitleBar.Content>
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- 仿照图吧工具箱风格的标准 320px 搜索框（天然原生垂直居中，右侧图标精确定位于输入框内） -->
          <Grid Grid.Column="0" Width="320" VerticalAlignment="Center" Margin="12,0,0,0">
            <TextBox x:Name="TitleBarSearchBox"
                     MinHeight="30"
                     VerticalAlignment="Center"
                     PlaceholderText="搜索英雄或物品 (Ctrl+F)"
                     TextChanged="TitleBarSearchBox_TextChanged"
                     KeyDown="TitleBarSearchBox_KeyDown"
                     AutomationProperties.Name="顶部搜索框" />
            <Button x:Name="TitleBarSearchSubmitButton"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Width="30" Height="30"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="TitleBarSearchSubmitButton_Click"
                    ToolTipService.ToolTip="搜索"
                    AutomationProperties.Name="执行搜索">
              <FontIcon FontSize="14" Glyph="&#xE721;" Foreground="{ThemeResource GameTextSecondaryBrush}" />
            </Button>
          </Grid>

          <!-- 右侧操作区 -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Margin="0,0,8,0">
            <Button x:Name="TitleBarRefreshButton" Width="34" Height="30" Padding="0" CornerRadius="4"
                    Background="Transparent" BorderThickness="0"
                    Click="TitleBarRefreshButton_Click"
                    ToolTipService.ToolTip="刷新当前数据" AutomationProperties.Name="刷新当前数据"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="{ThemeResource GameTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </Grid>
      </TitleBar.Content>
    </TitleBar>

    <!-- ================= 一级导航与主视图容器 (Row 1) ================= -->
    <NavigationView
        Grid.Row="1"
        x:Name="AppNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        IsPaneToggleButtonVisible="False"
        PaneDisplayMode="Auto"
        CompactPaneLength="50"
        OpenPaneLength="216"
        PaneTitle=""
        SelectionChanged="AppNavigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="英雄资料" Tag="heroes" IsSelected="True">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="物品资料" Tag="items">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xEB9D;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="实时教练" Tag="coach">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE705;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="赛后分析" Tag="analysis">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <NavigationView.Content>
        <Grid>

        <!-- ============ 英雄资料（独立页面：网格/属性分栏/详情） ============ -->
        <views:HeroesPage x:Name="HeroesPage" Visibility="Visible" />

        <!-- ============ 物品资料（独立页面：官网式分组 + 悬浮详情卡） ============ -->
        <views:ItemCatalogPage x:Name="ItemCatalogPage" Visibility="Collapsed" />
        <!-- ============ 实时教练（独立页面：GSI 状态/装备/提醒流/阵容与出装/克制选人） ============ -->
        <views:CoachPage x:Name="CoachPage" Visibility="Collapsed" />

        <!-- ============ 赛后分析（独立页面：历史对局/习惯统计/AI 复盘/操作回放） ============ -->
        <views:AnalysisPage x:Name="AnalysisPage" Visibility="Collapsed" />

        <!-- ============ 应用设置（独立页面：Dota 2 实时连接/教练功能/规则阈值/硬件状态/检查更新） ============ -->
        <views:SettingsPage x:Name="SettingsPage" Visibility="Collapsed" />
        </Grid>
      </NavigationView.Content>
    </NavigationView>
  </Grid>
</Window>
