<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AegisCoach.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:local="using:AegisCoach.Native.Converters"
    xmlns:views="using:AegisCoach.Native.Views"
    Title="神盾教练">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}" SizeChanged="RootGrid_SizeChanged" KeyDown="RootGrid_KeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ================= 顶层自定义标题栏 (Row 0, 44px) ================= -->
    <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44"
          Background="{ThemeResource GameSurfaceSubtleBrush}"
          BorderBrush="{ThemeResource GameBorderBrush}"
          BorderThickness="0,0,0,1">
      <!-- 独立窗口拖拽背景层（不阻断上层交互控件的点击与输入） -->
      <Border x:Name="TitleBarDragArea" Background="Transparent" />

      <Grid Height="44">
        <Grid.ColumnDefinitions>
          <!-- 0: 最左侧 - 左侧宽度对称平衡区（192px，对齐 50px 紧凑导航栏，保证中间搜索框绝对居中） -->
          <ColumnDefinition Width="192" />
          <!-- 1: 中间 - 绝对居中自适应搜索框 -->
          <ColumnDefinition Width="*" />
          <!-- 2: 最右侧 - 右侧宽度对称平衡区（192px，包含 32px 刷新按钮与 140px 系统控制按钮避让区） -->
          <ColumnDefinition Width="192" />
        </Grid.ColumnDefinitions>

        <!-- 最左侧：折叠/展开左侧导航按钮 + 图标与应用名（全套 32px 高度，严格垂直对齐，汉堡按钮居中于 50px 折叠导航栏） -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="9,0,0,0">
          <Button x:Name="NavPaneToggleButton" Width="32" Height="32" Padding="0"
                  Background="Transparent" BorderThickness="0" CornerRadius="4"
                  Click="NavPaneToggleButton_Click"
                  ToolTipService.ToolTip="折叠/展开导航栏 (Ctrl+B)"
                  AutomationProperties.Name="折叠/展开导航栏"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE700;" FontSize="13" Foreground="{ThemeResource GameTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <FontIcon Glyph="&#xE734;" FontSize="14" Foreground="{ThemeResource CoachGoldBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
          <TextBlock Text="神盾教练" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource GameTextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 中间：绝对居中自适应搜索框（高度严格 32px，与两侧按钮水平基准线完全一致） -->
        <AutoSuggestBox Grid.Column="1" x:Name="TitleBarSearchBox"
                        Width="360" MaxWidth="440" Height="32"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        QueryIcon="Find" PlaceholderText="搜索英雄或物品 (Ctrl+F)"
                        TextChanged="TitleBarSearchBox_TextChanged"
                        QuerySubmitted="TitleBarSearchBox_QuerySubmitted"
                        AutomationProperties.Name="顶部搜索框" />

        <!-- 最右侧：统一 32px 刷新按钮 + 系统控制按钮避让区（右对齐排布，与左侧对称平衡） -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="TitleBarRefreshButton" Width="32" Height="32" Padding="0" CornerRadius="4"
                  Background="Transparent" BorderThickness="0"
                  Click="TitleBarRefreshButton_Click"
                  ToolTipService.ToolTip="刷新当前数据" AutomationProperties.Name="刷新当前数据"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="0,0,12,0">
            <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{ThemeResource GameTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <!-- 避让 Windows 原生最小化/最大化/关闭按钮 (140px) -->
          <Border Width="140" Height="44" Background="Transparent" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- ================= 一级导航与主视图容器 (Row 1) ================= -->
    <NavigationView
        Grid.Row="1"
        x:Name="AppNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        IsPaneToggleButtonVisible="False"
        PaneDisplayMode="Auto"
        CompactPaneLength="50"
        OpenPaneLength="216"
        PaneTitle=""
        SelectionChanged="AppNavigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="英雄资料" Tag="heroes" IsSelected="True">
          <NavigationViewItem.Icon><SymbolIcon Symbol="People" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="物品资料" Tag="items">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Shop" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="实时教练" Tag="coach">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="赛后分析" Tag="analysis">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <NavigationView.Content>
        <Grid>

        <!-- ============ 英雄资料（独立页面：网格/属性分栏/详情） ============ -->
        <views:HeroesPage x:Name="HeroesPage" Visibility="Visible" />

        <!-- ============ 物品资料（独立页面：官网式分组 + 悬浮详情卡） ============ -->
        <views:ItemCatalogPage x:Name="ItemCatalogPage" Visibility="Collapsed" />
        <!-- ============ 实时教练（独立页面：GSI 状态/装备/提醒流/阵容与出装/克制选人） ============ -->
        <views:CoachPage x:Name="CoachPage" Visibility="Collapsed" />

        <!-- ============ 赛后分析 ============ -->
        <Grid x:Name="AnalysisPage" Visibility="Collapsed" Padding="24,18,24,22" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="赛后分析" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="AnalysisCountText" Text="0 份报告" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,2" />
              </StackPanel>
              <TextBlock Text="游戏习惯记录 + AI 复盘 · 数据来自本地 GSI 快照，不依赖网络也可出规则摘要" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" />
            </StackPanel>
            <StackPanel x:Name="AnalysisImportPanel" Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
              <TextBox x:Name="AnalysisMatchIdBox" Width="170" Height="32" PlaceholderText="输入比赛 ID" />
              <Button x:Name="AnalysisFetchMatchButton" Content="从 API 拉取复盘" Click="AnalysisFetchMatchButton_Click" Height="32" />
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Height="1" Background="{ThemeResource BorderBrush}" Margin="0,2,0,2" />

          <Border Grid.Row="2" Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12,8">
            <TextBlock x:Name="AnalysisSummaryText" Text="暂无历史对局…" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
          </Border>

          <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="AnalysisListColumn" Width="330" MinWidth="280" />
              <ColumnDefinition x:Name="AnalysisDetailColumn" Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="AnalysisList" Grid.Column="0" ItemsSource="{Binding AnalysisReports}" SelectionMode="Single" SelectionChanged="AnalysisList_SelectionChanged" Background="Transparent">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,0,0,8" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Border Background="{ThemeResource PanelBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10,8">
                    <StackPanel Spacing="2">
                      <Grid>
                        <TextBlock Text="{Binding Match.HeroName}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <Border HorizontalAlignment="Right" Padding="6,1" CornerRadius="2" Background="{Binding Match.Won, Converter={StaticResource ResultToBrushConverter}}">
                          <TextBlock Text="{Binding Match.ResultText}" Foreground="{ThemeResource OnAccentBrush}" FontSize="9" FontWeight="SemiBold" />
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Match.SummaryLine}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                      <TextBlock Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10">
                        <Run Text="{Binding GeneratedText}" /><Run Text=" · " /><Run Text="{Binding Backend}" />
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <Border x:Name="AnalysisDetailPanel" Grid.Column="1" Visibility="Collapsed" Background="{ThemeResource PanelBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="3">
              <Grid>
                <StackPanel x:Name="AnalysisEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                  <FontIcon Glyph="&#xE8A5;" FontSize="28" Foreground="{ThemeResource TertiaryTextBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="选择左侧报告查看复盘详情" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="12" />
                </StackPanel>
                <Grid x:Name="AnalysisDetailRoot" Visibility="Collapsed">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Style="{StaticResource GameIconButtonStyle}" Click="AnalysisCloseButton_Click" ToolTipService.ToolTip="关闭复盘详情" AutomationProperties.Name="关闭复盘详情">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                      </Button>
                      <TextBlock x:Name="AnalysisDetailHeaderText" Text="复盘详情" Foreground="{ThemeResource GameTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                  <ScrollViewer Grid.Row="1" x:Name="AnalysisDetailHost" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False">
                  <StackPanel Padding="18,16" Spacing="8">
                    <TextBlock x:Name="AnalysisDetailTitleText" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="AnalysisDetailMetaText" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock x:Name="AnalysisDetailBackendText" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="10" />
                    <Border BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,2" />

                    <Grid>
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE90A;" FontSize="14" Foreground="{ThemeResource CoachGoldBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="AI 复盘" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" />
                      </StackPanel>
                      <Button x:Name="AnalysisRegenerateButton" Content="重新生成复盘" Click="AnalysisRegenerateButton_Click" HorizontalAlignment="Right" Padding="10,4" FontSize="11" />
                    </Grid>
                    <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12">
                      <TextBlock x:Name="AnalysisDetailReviewText" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" LineHeight="20" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="最终装备" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock x:Name="AnalysisDetailItemsText" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />

                    <TextBlock Text="关键节点" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12">
                      <TextBlock x:Name="AnalysisDetailMomentsText" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="经济曲线（每 5 分钟采样）" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock x:Name="AnalysisDetailEconomyText" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />

                    <TextBlock Text="回放操作记录（GSI 提取）" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12">
                      <StackPanel>
                        <TextBlock x:Name="AnalysisOperationsEmptyText" Text="本局没有回放记录，无法提取操作。请确认 GSI 快照记录已开启后，点击“重新生成复盘”。" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock x:Name="AnalysisOperationsHost" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <TextBlock Text="整场数据（OpenDota）" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12">
                      <StackPanel>
                        <TextBlock x:Name="AnalysisApiEmptyText" Text="未拉取 OpenDota 整场数据。可在页面右上角输入比赛 ID 拉取，或点击“重新生成复盘”重试。" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock x:Name="AnalysisApiHost" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
        </Grid>
      </NavigationView.Content>
    </NavigationView>

    <ContentDialog
        x:Name="CoachSettingsDialog"
        Title="设置"
        PrimaryButtonText="保存设置"
        CloseButtonText="取消"
        DefaultButton="Primary"
        PrimaryButtonClick="CoachSettingsDialog_PrimaryButtonClick"
        MaxWidth="740">
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Stretch">
          <StackPanel Spacing="4">
            <TextBlock x:Name="SettingsIntroTitle" Text="完成基础设置后开始运行" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SettingsIntroText" Text="应用会自动处理本地连接和文件位置，通常不需要修改高级选项。" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>

          <!-- 1. Dota 2 实时连接模块 -->
          <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
            <StackPanel Spacing="14">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                  <TextBlock Text="Dota 2 实时连接" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="自动查找 Steam 中的 Dota 2 并安装所需 GSI 配置。" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" x:Name="CoachAutoStartBox" IsOn="True" OnContent="自动连接" OffContent="手动连接" />
              </Grid>

              <!-- 2x2 宽按钮网格，保证按钮文字完整展示，杜绝截断 -->
              <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Content="自动配置 Dota 2" Click="CoachInstallButton_Click" HorizontalAlignment="Stretch" Height="36" Style="{StaticResource AccentButtonStyle}" />
                <Button Grid.Row="0" Grid.Column="1" x:Name="CoachToggleButton" Content="立即连接" Click="CoachToggleButton_Click" HorizontalAlignment="Stretch" Height="36" />
                <Button Grid.Row="1" Grid.Column="0" Content="选择游戏目录" Click="CoachBrowseButton_Click" HorizontalAlignment="Stretch" Height="34" />
                <Button Grid.Row="1" Grid.Column="1" Content="打开配置目录" Click="CoachOpenCfgButton_Click" HorizontalAlignment="Stretch" Height="34" />
              </Grid>

              <InfoBar x:Name="CoachInfoBar" IsOpen="False" IsClosable="True" Severity="Informational" />
            </StackPanel>
          </Border>

          <!-- 2. 教练功能模块 -->
          <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Text="教练功能" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" />
              <CheckBox x:Name="SmartCoachEnabledBox" Content="启用智能解释" IsChecked="True" />
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="解释方式" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center" />
                <ComboBox x:Name="AiBackendBox" Grid.Column="1" MinHeight="36" HorizontalAlignment="Stretch" SelectionChanged="AiBackendBox_SelectionChanged" />
              </Grid>
              <CheckBox x:Name="LiveHeroTrackingEnabledBox" Content="显示全场英雄与出装建议（仅公开比赛）" />
            </StackPanel>
          </Border>

          <!-- 3. 数据保存位置 -->
          <Border Background="{ThemeResource SubtlePanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Spacing="3">
                <TextBlock Text="数据保存位置" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="DataDirectoryText" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="打开文件夹" Click="CoachOpenDataButton_Click" VerticalAlignment="Center" Height="34" />
            </Grid>
          </Border>

          <!-- 4. 高级设置（折叠面板） -->
          <Expander Header="高级设置" HorizontalAlignment="Stretch">
            <StackPanel Spacing="16" Padding="0,12,0,4">
              <!-- Dota 2 安装位置 -->
              <StackPanel Spacing="8">
                <TextBlock Text="Dota 2 安装位置" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="CoachPathBox" PlaceholderText="仅在自动查找失败时选择" IsReadOnly="True" Height="34" />
                  <Button Grid.Column="1" Content="选择目录" Click="CoachBrowseButton_Click" Height="34" />
                </Grid>
              </StackPanel>

              <!-- 教练提醒规则 -->
              <StackPanel Spacing="10">
                <TextBlock Text="教练提醒阈值与规则" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                <Grid ColumnSpacing="10" RowSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <TextBlock Text="低血提醒 %" VerticalAlignment="Center" /><TextBox Grid.Column="1" x:Name="CoachLowHealthBox" Height="32" />
                  <TextBlock Grid.Column="2" Text="低蓝提醒 %" VerticalAlignment="Center" /><TextBox Grid.Column="3" x:Name="CoachLowManaBox" Height="32" />
                  <TextBlock Grid.Row="1" Text="集结生命 %" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" x:Name="CoachFightHealthBox" Height="32" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="集结魔法 %" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="3" x:Name="CoachFightManaBox" Height="32" />
                </Grid>

                <!-- 5 列整齐排布的提醒开关网格，绝不挤压溢出 -->
                <Grid ColumnSpacing="8" RowSpacing="6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <CheckBox Grid.Row="0" Grid.Column="0" x:Name="CoachLowHealthEnabledBox" Content="低血" />
                  <CheckBox Grid.Row="0" Grid.Column="1" x:Name="CoachLowManaEnabledBox" Content="低蓝" />
                  <CheckBox Grid.Row="0" Grid.Column="2" x:Name="CoachUltimateEnabledBox" Content="大招" />
                  <CheckBox Grid.Row="0" Grid.Column="3" x:Name="CoachDeathEnabledBox" Content="阵亡" />
                  <CheckBox Grid.Row="0" Grid.Column="4" x:Name="CoachControlEnabledBox" Content="受控" />

                  <CheckBox Grid.Row="1" Grid.Column="0" x:Name="CoachBuybackEnabledBox" Content="买活" />
                  <CheckBox Grid.Row="1" Grid.Column="1" x:Name="CoachFightReadyEnabledBox" Content="集结" />
                  <CheckBox Grid.Row="1" Grid.Column="2" x:Name="CoachSmokeEnabledBox" Content="开雾" />
                  <CheckBox Grid.Row="1" Grid.Column="3" x:Name="CoachSmokedEnabledBox" Content="雾中" />
                  <CheckBox Grid.Row="1" Grid.Column="4" x:Name="CoachNightEnabledBox" Content="天黑" />

                  <CheckBox Grid.Row="2" Grid.Column="0" x:Name="CoachBuildingEnabledBox" Content="建筑" />
                  <CheckBox Grid.Row="2" Grid.Column="1" x:Name="CoachRoshanEnabledBox" Content="肉山" />
                  <CheckBox Grid.Row="2" Grid.Column="2" x:Name="CoachItemReadyEnabledBox" Content="道具就绪" />
                  <CheckBox Grid.Row="2" Grid.Column="3" x:Name="CoachAbilityReadyEnabledBox" Content="技能就绪" />
                  <CheckBox Grid.Row="2" Grid.Column="4" x:Name="CoachMapAwarenessEnabledBox" Content="关键时间" />
                </Grid>

                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                  <ComboBox x:Name="CoachCooldownRuleBox" Header="提醒类型" HorizontalAlignment="Stretch" SelectionChanged="CoachCooldownRuleBox_SelectionChanged" />
                  <NumberBox x:Name="CoachCooldownSecondsBox" Grid.Column="1" Header="冷却（秒）" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" />
                </Grid>
              </StackPanel>

              <!-- 本地模型状态提示 -->
              <Border x:Name="NpuSection" Background="{ThemeResource PanelBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="本机硬件状态" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock x:Name="NpuModelStatusText" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="NpuModelPathBox" IsReadOnly="True" Height="34" />
                    <Button Grid.Column="1" Content="选择目录" Click="CoachBrowseModelButton_Click" Height="34" />
                  </Grid>
                  <TextBlock x:Name="NpuStatusText" Text="保存后检查本机能力" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- AI 智能解释（云端 / 本地 Ollama 兼容端点） -->
              <Border x:Name="CloudSection" Visibility="Collapsed" Background="{ThemeResource PanelBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="10">
                  <TextBlock Text="AI 智能解释配置（支持 OpenAI / DeepSeek / Ollama / LocalAI）" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                  <PasswordBox x:Name="CloudApiKeyBox" Header="API 密钥（本地 Ollama 可填任意字符）" PlaceholderText="安全保存在 Windows 凭据保险库" />
                  <Expander Header="自定义接口地址与模型名称" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="8" RowSpacing="8" Padding="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <TextBlock Text="接口地址" VerticalAlignment="Center" /><TextBox Grid.Column="1" x:Name="CloudEndpointBox" Height="32" PlaceholderText="如 https://api.deepseek.com/v1 或 http://localhost:11434/v1" />
                      <TextBlock Grid.Row="1" Text="模型名称" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" x:Name="CloudModelBox" Height="32" PlaceholderText="如 deepseek-chat 或 qwen2.5:7b" />
                    </Grid>
                  </Expander>
                  <Button Content="测试接口连接" Click="SmartCoachCloudProbeButton_Click" HorizontalAlignment="Left" Height="34" />
                </StackPanel>
              </Border>

              <!-- 数据增强 -->
              <StackPanel Spacing="8">
                <TextBlock Text="数据增强" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                <PasswordBox x:Name="StratzApiKeyBox" Header="Stratz API 密钥（可选）" PlaceholderText="留空使用公开数据；填写后保存到 Windows 凭据保险库" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="解释间隔" VerticalAlignment="Center" /><TextBox Grid.Column="1" x:Name="SmartCoachIntervalBox" Text="3" Height="32" />
                  <TextBlock Grid.Column="2" Text="秒" Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <!-- 运行记录 -->
              <StackPanel Spacing="8">
                <TextBlock Text="运行记录" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                <Border Background="{ThemeResource PanelBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" Padding="8" MaxHeight="130" CornerRadius="4">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="CoachLogText" Text="尚未启动" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" /></ScrollViewer>
                </Border>
                <TextBlock x:Name="SmartCoachStatusText" Text="规则提醒可离线运行" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </ContentDialog>
  </Grid>
</Window>