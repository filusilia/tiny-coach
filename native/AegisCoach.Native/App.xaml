<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AegisCoach.Native.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AegisCoach.Native.Converters">
  <Application.Resources>
    <ResourceDictionary>
    <local:SeverityToBrushConverter x:Key="SeverityBrushConverter" />
    <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsedConverter" />
    <local:CollectionCountToVisibilityConverter x:Key="CollectionCountToVisibilityConverter" />
    <local:ResultToBrushConverter x:Key="ResultToBrushConverter" />
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemChromeMediumLowColor}" />
      <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="{ThemeResource SystemChromeLowColor}" />
      <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{ThemeResource SystemAltHighColor}" />
      <SolidColorBrush x:Key="SubtlePanelBrush" Color="{ThemeResource SystemAltLowColor}" />
      <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource SystemBaseLowColor}" />
      <SolidColorBrush x:Key="SubtleBorderBrush" Color="{ThemeResource SystemBaseLowColor}" />
      <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource SystemBaseHighColor}" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemBaseMediumHighColor}" />
      <SolidColorBrush x:Key="TertiaryTextBrush" Color="{ThemeResource SystemBaseMediumColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="{ThemeResource SystemAccentColorDark1}" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="{ThemeResource SystemAltHighColor}" />
      <SolidColorBrush x:Key="HeroOverlayBrush" Color="#66000000" />
      <SolidColorBrush x:Key="ScepterBrush" Color="{ThemeResource SystemAccentColorDark2}" />
      <SolidColorBrush x:Key="ShardBrush" Color="{ThemeResource SystemAccentColorLight1}" />
      <SolidColorBrush x:Key="InfoBrush" Color="{ThemeResource SystemAccentColor}" />
      <SolidColorBrush x:Key="WarningBrush" Color="#C47724" />
      <SolidColorBrush x:Key="CriticalBrush" Color="#C42B1C" />

      <!-- 神盾教练专属配色：Dota 2 风格暗色电竞面板 + 琥珀金点缀 -->
      <SolidColorBrush x:Key="CoachGoldBrush" Color="#D9A441" />
      <SolidColorBrush x:Key="CoachGoldLightBrush" Color="#F2C56B" />
      <SolidColorBrush x:Key="CoachGoldDarkBrush" Color="#8A6420" />
      <SolidColorBrush x:Key="CoachDangerBrush" Color="#E5484D" />
      <SolidColorBrush x:Key="CoachSuccessBrush" Color="#4CAF50" />
      <SolidColorBrush x:Key="CoachInfoBlueBrush" Color="#4A90D9" />
      <SolidColorBrush x:Key="CoachNeutralBrush" Color="#6B7280" />
      <SolidColorBrush x:Key="CoachPanelTintBrush" Color="{ThemeResource SystemAltLowColor}" />
      <SolidColorBrush x:Key="CoachPanelTintAltBrush" Color="{ThemeResource SystemChromeLowColor}" />

      <!-- 英雄属性色：力量红 / 敏捷绿 / 智力蓝 / 全才金 -->
      <SolidColorBrush x:Key="HeroAttrStrBrush" Color="#D64545" />
      <SolidColorBrush x:Key="HeroAttrAgiBrush" Color="#3DA35D" />
      <SolidColorBrush x:Key="HeroAttrIntBrush" Color="#3D7BD9" />
      <SolidColorBrush x:Key="HeroAttrAllBrush" Color="#D9A441" />

      <!-- Dota 2 风格天赋树 -->
      <SolidColorBrush x:Key="TalentSpineBrush" Color="#3A4A63" />
      <SolidColorBrush x:Key="TalentNodeBrush" Color="{ThemeResource SystemAltLowColor}" />
      <SolidColorBrush x:Key="TalentNodeBorderBrush" Color="{ThemeResource SystemBaseLowColor}" />
      <SolidColorBrush x:Key="TalentNodeHoverBrush" Color="#22314D" />
      <SolidColorBrush x:Key="TalentNodeCheckedBrush" Color="#3A2F14" />
      <SolidColorBrush x:Key="TalentLevelBadgeBrush" Color="#1B2740" />
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="Themes/GameReferenceStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>



