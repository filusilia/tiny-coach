<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AegisCoach.Smoke</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\native\AegisCoach.Native\Core\Models\**\*.cs"
             Link="Core\Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\native\AegisCoach.Native\Core\Services\**\*.cs"
             Link="Core\Services\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\native\AegisCoach.Native\Services\CoachAiPrompts.cs"
             Link="Native\Services\CoachAiPrompts.cs" />
  </ItemGroup>
</Project>
